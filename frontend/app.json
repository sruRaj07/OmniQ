{
  "expo": {
    "name": "OmniQ",
    "slug": "omniq",
    "scheme": "omniq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
