{
  "expo": {
    "name": "OmniQ",
    "slug": "omniq",
    "scheme": "omniq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": true
          }
        }
      ],
      [
        "expo-image",
        {
          "maxMemoryCacheSize": 50,
          "maxDiskCacheSize": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OmniQ needs access to your photos so you can attach pictures to the products you list for sale."
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "omniq-ecommerce-application",
          "organization": "omniq-ecommerce-pvt-ltd"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omniq.app",
      "jsEngine": "hermes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.omniq.ecommerce",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 29,
      "jsEngine": "hermes",
      "//blockedPermissions": "Background location, camera, and audio recording are blocked to comply with Google Play least-privilege policies. Foreground GPS location is only requested on-demand when the buyer explicitly taps 'Fetch Precise Location' to compute exact road-distance delivery fees.",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a29b09a-2b5d-4bac-96d5-b2e63d6050bc"
      }
    },
    "owner": "rajsrus-team"
  }
}
