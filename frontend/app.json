{
  "expo": {
    "name": "OmniQ",
    "slug": "omniq",
    "scheme": "omniq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": true
          }
        }
      ],
      [
        "expo-image",
        {
          "maxMemoryCacheSize": 50,
          "maxDiskCacheSize": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OmniQ needs access to your photos so you can attach pictures to the products you list for sale."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omniq.app",
      "jsEngine": "hermes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sruraj.omniq",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 10,
      "jsEngine": "hermes",
      "//blockedPermissions": "The app never opens the camera (only ImagePicker.launchImageLibraryAsync) and never reads GPS - useLocation checks a pincode against the delivery-zone API. expo-image-picker's manifest still declares CAMERA, and any transitive dependency can reintroduce location. Stripping them here keeps the manifest matching the Play Data Safety declaration, which states no location and no camera.",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a29b09a-2b5d-4bac-96d5-b2e63d6050bc"
      }
    },
    "owner": "rajsrus-team"
  }
}
